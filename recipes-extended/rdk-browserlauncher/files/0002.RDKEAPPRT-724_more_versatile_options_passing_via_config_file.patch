+    key_match_e matchKey(const std::string &key, const std::string &var, bool strict, bool keyFlag = true)
+    {
+        auto ret = MATCH_NONE;
+        if (strict)
+        {
+            return ( key == var ) ? MATCH_POSITIVE : MATCH_NONE;
+        }
+        else if (g_ascii_strcasecmp(key.c_str(), var.c_str()) == 0)
+        {
+            ret = MATCH_POSITIVE;
+        }
+        else if (g_ascii_strncasecmp(key.c_str(), "enable", 6) == 0)
+        {
+            if (keyFlag)
+            {
+                ret = matchKey(key.substr(6), var, strict, false);
+            }
+        }
+        else if (g_ascii_strncasecmp(key.c_str(), "disable", 7) == 0)
+        {
+            if (keyFlag)
+            {
+                ret = matchKey(key.substr(7), var, strict, false);
+                if (ret == MATCH_POSITIVE)
+                {
+                    ret = MATCH_NEGATIVE;
+                }
+                else if (ret == MATCH_NEGATIVE)
+                {
