+static gchar* resolvePackageUrl(const gchar* value)
+{
+    gchar_ptr scheme { g_uri_parse_scheme(value) };
+    if (scheme)
+        return g_strdup(value);
+
+    std::filesystem::path path = resolveLocalFilePath(value);
+
+    std::error_code ec;
+    if (std::filesystem::is_directory(path, ec))
+        path /= "index.html";
+
+    gchar *resolved = g_strconcat("file://", path.c_str(), nullptr);
+    g_message("resolved package uri '%s' to '%s'", value, resolved);
+    return resolved;
+}
